# ─── SECRETS TEMPLATE ────────────────────────────────────────────────────────
# Copy this file to `secrets.properties` (same folder) and fill in real values.
# `secrets.properties` is gitignored, so your real keys never get committed.
# If it's absent the app still runs (email logs codes to the console; tutor 503s).
#
#   cp secrets.properties.example secrets.properties
#
# Then edit secrets.properties with:

# Google AI Studio key for the AI Tutor (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-key

# SMTP relay that sends account-verification emails. Defaults to Gmail
# (smtp.gmail.com) if MAIL_HOST is omitted — swap in any SMTP provider's
# values here (e.g. Brevo: smtp-relay.brevo.com, port 587, the SMTP login +
# key shown in Brevo's SMTP & API settings page).
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password-or-key
MAIL_FROM=FinLit <no-reply@your-domain.com>

# Paystack SECRET key (starts with sk_test_...) — from your Paystack dashboard
# under Settings -> API Keys & Webhooks. This is server-side only, used to
# verify a payment before granting premium. Without it, POST /profile/premium
# returns 503. NOT the pk_test_... publishable key — that one goes in the
# frontend's .env as EXPO_PUBLIC_PAYSTACK_KEY, since it's meant to be public.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
