# ─── SECRETS TEMPLATE ────────────────────────────────────────────────────────
# Copy this file to `secrets.properties` (same folder) and fill in real values.
# `secrets.properties` is gitignored, so your real keys never get committed.
# If it's absent the app still runs (email logs codes to the console; tutor 503s).
#
#   cp secrets.properties.example secrets.properties
#
# Then edit secrets.properties with:

# Gmail account that SENDS verification emails + its 16-char App Password
# (Google account -> 2-Step Verification -> App passwords). No spaces.
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_FROM=FinLit <your-account@gmail.com>

# Google AI Studio key for the AI Tutor (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-key
